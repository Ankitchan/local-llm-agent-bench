# Copy to config.env and edit. Sourced by scripts/*.sh. Everything has a default.
# Command that starts llama.cpp's server. Upstream ships `llama-server`. If your build has the `llama serve` wrapper, use:
#   LLAMA_CMD="llama serve"
LLAMA_CMD=llama-server
PORT=8081
CTX=65536
FIT_TARGET=900        # MiB of VRAM that --fit leaves free
BATCH=4096            # -b and -ub
# URL the Python tools talk to (defaults to http://127.0.0.1:$PORT)
# LLM_URL=http://127.0.0.1:8081
