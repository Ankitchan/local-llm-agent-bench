# Copy to serve/model.env and edit. Switching models = edit MODEL_PATH and ALIAS, then restart the service.
MODEL_PATH=/path/to/Ornith-1.5-35B-A3B-IQ3_M.gguf
ALIAS=my-model
# Command that starts llama.cpp's server: "llama-server" upstream, or "llama serve" if your build has the wrapper.
LLAMA_CMD=llama-server
CTX=65536
FIT_TARGET=900      # MiB of VRAM kept free
PORT=8081           # the server; the systemd socket in front of it listens on 8080
BATCH=4096
# Seconds idle before the model unloads and frees RAM. This is what actually releases memory; see README.
IDLE_SLEEP=600
